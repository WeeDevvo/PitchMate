# openapi-typescript (used by @pitchmate/api-client for OpenAPI -> TS codegen) declares a stale
# peerDependency on typescript@^5.x. This monorepo pins typescript ~6.0.2, which the tool works
# with fine (the codegen only uses the compiler API for AST emission). legacy-peer-deps lets npm
# install/ci proceed past that outdated peer range instead of erroring on ERESOLVE. Revisit and
# remove once openapi-typescript widens its typescript peer range to include 6.x.
legacy-peer-deps=true
